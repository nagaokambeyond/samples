# Local development credentials only. Copy to .env to override these values.
MYSQL_DATABASE=keycloak
MYSQL_USER=keycloak
MYSQL_PASSWORD=keycloak-password
MYSQL_ROOT_PASSWORD=root-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-password
# Change only when host port 8080 is already in use.
KEYCLOAK_PORT=8080

# Must match the corresponding secret in keycloak/realm-export.json when changed.
PORTAL_CLIENT_SECRET=portal-client-secret
REPORTS_CLIENT_SECRET=reports-client-secret
